INFERENCE_BASE_URL=https://inference.example/v1
INFERENCE_API_KEY=replace-me
INFERENCE_MODEL=replace-me
INFERENCE_TIMEOUT=120
INFERENCE_MAX_RETRIES=3
INFERENCE_VISION=1
BRANDDECK_WORKSPACE=./slide-workspace
# Optional path if LibreOffice is not installed in a standard location:
# BRANDDECK_LIBREOFFICE=C:/Program Files/LibreOffice/program/soffice.com
# auto skips PowerPoint COM when PowerPoint is not installed.
BRANDDECK_POWERPOINT_QA=auto
