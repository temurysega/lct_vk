INFERENCE_BASE_URL=https://inference.example/v1
INFERENCE_API_KEY=replace-me
INFERENCE_MODEL=replace-me
INFERENCE_TIMEOUT=120
INFERENCE_MAX_RETRIES=3
INFERENCE_VISION=1
# Slides of a brief written in parallel; match llama-server --parallel.
INFERENCE_PARALLEL=1
# JSON merged into every request, e.g. disable Qwen3.5 thinking:
# INFERENCE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
BRANDDECK_WORKSPACE=./slide-workspace
# Set to 1 behind HTTPS in public deployments. Keep 0 for local HTTP development.
PREDEL_SECURE_COOKIES=0
# Optional path if LibreOffice is not installed in a standard location:
# BRANDDECK_LIBREOFFICE=C:/Program Files/LibreOffice/program/soffice.com
# auto skips PowerPoint COM when PowerPoint is not installed.
BRANDDECK_POWERPOINT_QA=auto
# Optional text audit of the plan by the model (rewrites flagged brief slides).
INFERENCE_CONTEXT_AUDIT=0
# Optional visual audit of rendered PNGs; needs INFERENCE_VISION=1 and a VLM.
INFERENCE_RENDER_AUDIT=0
INFERENCE_RENDER_AUDIT_TIMEOUT=60
# 0 keeps the per-stage max_tokens; a positive value caps every request.
INFERENCE_MAX_OUTPUT_TOKENS=0
# Run heavy jobs one at a time on a small server.
BRANDDECK_CPU_MODE=0
# Optional text-to-image server (OpenAI-compatible /images/generations).
# IMAGE_BASE_URL=http://127.0.0.1:8081/v1
# IMAGE_MODEL=replace-me
# IMAGE_API_KEY=
# IMAGE_SIZE=1024x768
# IMAGE_TIMEOUT=180
# IMAGE_MAX_PER_DECK=3
# IMAGE_AUTO=0
